# =============================================================================
# Urban Heat Mitigation Platform - Production Environment Variables
# Copy to .env and fill in all values before deploying
# =============================================================================
# cp .env.production .env && vi .env
# =============================================================================

# ===== Database =====
POSTGRES_USER=urbanheat
POSTGRES_PASSWORD=CHANGE_ME_32_CHAR_HEX
POSTGRES_DB=urbanheat
POSTGRES_PORT=5432

# ===== JWT / Auth =====
SECRET_KEY=CHANGE_ME_64_CHAR_HEX
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ===== Object Storage (MinIO) =====
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_32_CHAR
MINIO_BUCKET=urbanheat-data

# ===== API / URLs =====
BACKEND_CORS_ORIGINS=["https://urbanheat.io","https://www.urbanheat.io"]
FRONTEND_URL=https://urbanheat.io
BACKEND_URL=https://api.urbanheat.io
API_V1_STR=/api/v1

# ===== Domain (for HTTPS) =====
DOMAIN=urbanheat.io

# ===== Email / SMTP =====
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.sendgrid.net
SMTP_USER=apikey
SMTP_PASSWORD=CHANGE_ME_SENDGRID_KEY
EMAILS_FROM_EMAIL=noreply@urbanheat.io
EMAILS_FROM_NAME=Urban Heat Mitigation Platform

# ===== External APIs =====
BHUVAN_API_KEY=
OPENWEATHER_API_KEY=

# ===== Monitoring =====
SENTRY_DSN=
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA

# ===== Celery =====
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_WORKER_CONCURRENCY=4

# ===== App Version =====
APP_VERSION=1.0.0

# ===== Environment =====
ENVIRONMENT=production
